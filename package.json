  "main": "index.js",
  "scripts": {
    "start": "npm install && DEBUG=NOWapis* NODE_ENV=staging ./node_modules/nodemon/bin/nodemon.js ./bin/api.js",
    "cron": "npm install && DEBUG=NOWapis* NODE_ENV=staging ./node_modules/nodemon/bin/nodemon.js ./cron.js",
    "api": "npm install && DEBUG=NOWapis* NODE_ENV=staging ./node_modules/nodemon/bin/nodemon.js ./bin/api.js",
    "test": "DEBUG=NOWapis:test* node_modules/mocha/bin/mocha --require babel-core/register"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/nownews/NOWapis.git"
  },
