    "babel-polyfill": "6.13.0",
    "babel-preset-es2015": "6.14.0",
    "babel-preset-stage-0": "6.5.0",
    "bluebird": "3.4.6",
    "body-parser": "1.15.2",
    "chai": "3.5.0",
    "chalk": "1.1.3",
    "cheerio": "0.20.0",
    "co": "4.6.0",
    "compression": "1.6.2",
    "cors": "2.8.1",
